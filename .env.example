# Supabase Utama (Main Data Center)
# Use the service role key for SUPABASE_UTAMA_KEY so the server can upsert game_sessions
# (RLS bypass). Do not use the anon key here unless policies explicitly allow server writes.
SUPABASE_UTAMA_URL=your-supabase-url
SUPABASE_UTAMA_KEY=your-supabase-service-role-key

# Supabase B (Sessions & Participants)
SUPABASE_B_URL=your-supabase-url-b
SUPABASE_B_KEY=your-supabase-anon-key-b

# Client Environment
# VITE_SERVER_URL=ws://localhost:2567
